# Copy to .env and adjust as needed. All values here have safe defaults
# in app/config.py, so the app runs fine with zero setup for local dev.

# --- Database ---
DATABASE_URL=sqlite:///./hackteam.db
# For Postgres in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/hackteam

# --- Admin login ---
# On first startup, if no admin account exists yet, one is created
# automatically using these values (or a random password if
# ADMIN_BOOTSTRAP_PASSWORD is left blank -- check the server logs).
# Log in at /api/auth/login, then create/manage further admin accounts
# from the in-app dashboard.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Secret used to sign admin session tokens. MUST be set to a long random
# value in production -- otherwise a fresh one is generated every restart
# and every admin gets logged out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=720

# --- CORS ---
CORS_ORIGINS=*

# --- AI explanation layer (optional) ---
# If set, team explanations are generated by Claude instead of templates.
ANTHROPIC_API_KEY=

# --- Misc ---
ENVIRONMENT=development
LOG_LEVEL=INFO
